<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat paysage pour le planning -->
    <record id="paperformat_planning_landscape" model="report.paperformat">
        <field name="name">Planning Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Template QWeb pour le rapport PDF du planning -->
    <template id="report_planning_weekly_pdf">
        <t t-call="web.html_container">
            <style type="text/css">
                /* ================================
                   PLANNING VISUAL CSS - SANS VARIABLES CSS (wkhtmltopdf ne les supporte pas)
                   ================================ */
                
                /* Styles pour l'export PDF */
                body {
                    margin: 0 !important;
                    padding: 20px !important;
                    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
                    background: white !important;
                }
                
                .planning-container {
                    max-width: 100% !important;
                    width: 100% !important;
                    margin: 0 !important;
                    padding: 20px !important;
                    page-break-after: always;
                }
                
                .planning-container:last-child {
                    page-break-after: auto;
                }
                
                /* Masquer les boutons et navigation */
                .btn, button, a.btn, .week-navigator > div:first-child,
                .week-navigator > div:last-child, .week-navigator .btn,
                .row.mb-3 {
                    display: none !important;
                }
                
                /* Garder seulement le titre */
                .week-navigator {
                    display: flex !important;
                    justify-content: center !important;
                    align-items: center !important;
                    padding: 10px !important;
                    margin-bottom: 15px !important;
                }
                
                .week-title {
                    margin: 0 !important;
                    font-size: 1.5rem !important;
                }
                
                /* ================================
                   TABLEAU PRINCIPAL ET STRUCTURE
                   ================================ */
                
                .planning-table-container {
                    overflow-x: auto;
                    background: white;
                    border-radius: 16px;
                    border: 2px solid #d1d5db;
                    box-shadow: 0 8px 25px rgba(30, 58, 138, 0.12);
                    padding: 0;
                }
                
                .planning-table {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 0;
                    font-size: 0.875rem;
                    min-width: 900px;
                    background: white;
                    border-radius: 16px;
                    overflow: hidden;
                }
                
                .planning-table th,
                .planning-table td {
                    border: none;
                    text-align: center;
                    vertical-align: middle !important;
                    padding: 0;
                    border-bottom: 1px solid #e5e7eb;
                    border-right: 2px solid #d1d5db;
                }
                
                /* ================================
                   EN-TÊTES STYLE CHC
                   ================================ */
                
                .header-row th {
                    background-color: #1e3a8a !important;
                    color: white !important;
                    font-weight: 600;
                    padding: 16px 12px;
                    font-size: 0.8rem;
                    letter-spacing: 0.025em;
                    text-transform: uppercase;
                    border-right: 2px solid rgba(255, 255, 255, 0.2);
                }
                
                .header-row th:first-child {
                    background-color: #1e3a8a !important;
                    width: 180px;
                    min-width: 180px;
                    text-align: left;
                    padding-left: 20px !important;
                    border-top-left-radius: 16px;
                    text-transform: none;
                    font-size: 0.9rem;
                }
                
                .period-row th {
                    padding: 10px;
                    font-weight: 600;
                    font-size: 0.8rem;
                    color: white !important;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    border-right: 2px solid rgba(255, 255, 255, 0.2);
                }
                
                .period-row th:first-child {
                    background-color: #1e3a8a !important;
                }
                
                .am-period {
                    background-color: #0ea5e9 !important;
                }
                
                .pm-period {
                    background-color: #e53e3e !important;
                    color: white !important;
                }
                
                /* ================================
                   CELLULES DE SITES CHC
                   ================================ */
                
                .site-cell {
                    background-color: #ffffff !important;
                    border-right: 2px solid #d1d5db;
                    padding: 12px 16px 12px 20px;
                    text-align: left;
                    vertical-align: middle;
                    width: 190px;
                    min-width: 190px;
                    font-weight: 600;
                    font-size: 0.95rem;
                    color: #0f172a !important;
                }
                
                .site-name {
                    display: flex;
                    align-items: center;
                    justify-content: flex-start;
                    gap: 10px;
                }
                
                .site-badge {
                    display: none !important;
                }
                
                .badge-HRM { 
                    background-color: #059669 !important;
                }
                
                .badge-HEU { 
                    background-color: #0ea5e9 !important;
                }
                
                .badge-WAR { 
                    background-color: #fbbf24 !important;
                    color: #1f2937 !important;
                }
                
                .badge-MLE { 
                    background-color: #e53e3e !important;
                }
                
                .badge-perm-functional {
                    background-color: #0ea5e9 !important;
                }
                
                .badge-perm-technical {
                    background-color: #6b7280 !important;
                }
                
                .site-fullname {
                    font-size: 0.85rem;
                    font-weight: 600;
                    color: #0f172a !important;
                }
                
                /* ================================
                   CELLULES D'AFFECTATION CHC
                   ================================ */
                
                .assignment-cell {
                    padding: 6px;
                    min-width: 50px;
                    max-width: 50px;
                    width: 50px;
                    height: 40px;
                    position: relative;
                    overflow: visible;
                    white-space: nowrap;
                    background-color: white !important;
                    border-right: 1px solid #e5e7eb;
                    vertical-align: middle;
                }
                
                .am-cell {
                    background-color: #f0f9ff !important;
                    border-left: 2px solid #d1d5db;
                }
                
                .pm-cell {
                    background-color: #fef2f2 !important;
                    border-right: 2px solid #d1d5db;
                }
                
                .full-day-cell {
                    min-width: 100px;
                    max-width: 100px;
                    width: 100px;
                    background: linear-gradient(to right, #f0f9ff 50%, #fef2f2 50%) !important;
                    border-right: 2px solid #d1d5db !important;
                    vertical-align: middle;
                }
                
                .assignment-wrapper {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: 100%;
                    height: 100%;
                    position: relative;
                    min-height: 32px;
                }
                
                /* ================================
                   CODES D'EMPLOYÉS STYLE CHC
                   ================================ */
                
                .assignment-code {
                    font-weight: 600;
                    padding: 6px 8px;
                    border-radius: 6px;
                    font-size: 0.8rem;
                    display: block;
                    min-width: 70%;
                    max-width: 70%;
                    border: none;
                    text-align: center;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    position: relative;
                    z-index: 1;
                    letter-spacing: 0.025em;
                    background-color: #fbbf24;
                    color: #1f2937;
                    box-shadow: 0 2px 4px rgba(251, 191, 36, 0.3);
                    margin: 0 auto;
                }
                
                /* ================================
                   INDICATEUR D'HEURES ÉTENDUES
                   ================================ */
                
                .extended-indicator-wrapper {
                    position: absolute !important;
                    top: -2px !important;
                    right: 4px !important;
                    width: 20px;
                    height: 20px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    z-index: 50 !important;
                    pointer-events: none;
                }
                
                .extended-indicator {
                    font-size: 14px;
                    line-height: 1;
                    font-weight: 900;
                    color: #dc2626;
                    font-family: "Segoe UI", "DejaVu Sans", sans-serif;
                }
                
                /* ================================
                   RANGÉES STYLE CHC
                   ================================ */
                
                .assignment-row {
                    height: 44px;
                    border-bottom: 1px solid #e5e7eb;
                }
                
                .assignment-row:nth-child(odd) {
                    background-color: rgba(249, 250, 251, 0.5);
                }
                
                /* ================================
                   FORCER LES COULEURS POUR PDF
                   ================================ */
                
                * {
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-call="chc_cds_planning.report_planning_weekly_content"/>
            </t>
        </t>
    </template>

    <!-- Contenu du rapport (web.html_container fournit déjà html/head/body) -->
    <template id="report_planning_weekly_content">
        <t t-set="o" t-value="doc"/>
        <t t-set="planning" t-value="o"/>
        
        <!-- Préparer les données pour le template -->
        <t t-set="data" t-value="o._prepare_planning_data_for_export()"/>
        <t t-set="table_rows" t-value="data.get('table_rows', [])"/>
        <t t-set="days" t-value="data.get('days', [])"/>
        
        <div class="container-fluid planning-container">
                    <!-- Titre de la semaine -->
                    <div class="week-navigator">
                        <span class="week-title">
                            <span t-if="planning.start_date and planning.end_date">
                                Semaine du <t t-esc="planning.start_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                au <t t-esc="planning.end_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </span>
                            <span t-else="">Planning sans dates</span>
                        </span>
                    </div>

                    <!-- Tableau du planning -->
                    <div class="planning-table-container" t-if="table_rows">
                        <table class="planning-table">
                            <thead>
                                <!-- En-tête principal avec les jours -->
                                <tr class="header-row">
                                    <th class="site-column">Activités</th>
                                    <t t-if="days" t-foreach="days" t-as="day">
                                        <th colspan="2" class="day-column">
                                            <div class="day-name">
                                                <t t-esc="day['name']"/>
                                            </div>
                                            <div class="day-date">
                                                <t t-esc="day['date_formatted']"/>
                                            </div>
                                        </th>
                                    </t>
                                </tr>
                                <!-- Sous-en-tête AM/PM -->
                                <tr class="period-row">
                                    <th></th>
                                    <t t-if="days" t-foreach="days" t-as="day">
                                        <th class="am-period">AM</th>
                                        <th class="pm-period">PM</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="table_rows" t-as="row">
                                    <!-- SITES ISOLÉS -->
                                    <t t-if="row['type'] == 'site_header'">
                                        <tr class="assignment-row">
                                            <td class="site-cell">
                                                <div class="site-name">
                                                    <span class="site-fullname">
                                                        <t t-esc="row['site']['name']"/>
                                                    </span>
                                                </div>
                                            </td>
                                            <t t-foreach="row['days_assignments']" t-as="day_data">
                                                <t t-if="day_data['am'] and day_data['am'].get('period') == 'full'">
                                                    <td class="assignment-cell full-day-cell" colspan="2">
                                                        <div class="assignment-wrapper">
                                                            <div class="assignment-code" t-att-style="day_data['am'].get('color_style', '')">
                                                                <t t-esc="day_data['am']['code']"/>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="assignment-cell am-cell">
                                                        <t t-if="day_data['am']">
                                                            <div class="assignment-wrapper">
                                                                <div class="assignment-code" t-att-style="day_data['am'].get('color_style', '')">
                                                                    <t t-esc="day_data['am']['code']"/>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </td>
                                                    <td class="assignment-cell pm-cell">
                                                        <t t-if="day_data['pm']">
                                                            <div class="assignment-wrapper">
                                                                <div class="assignment-code" t-att-style="day_data['pm'].get('color_style', '')">
                                                                    <t t-esc="day_data['pm']['code']"/>
                                                                </div>
                                                                <t t-if="day_data['pm'].get('has_extended_hours', False)">
                                                                    <div class="extended-indicator-wrapper">
                                                                        <span class="extended-indicator">X</span>
                                                                    </div>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </td>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>

                                    <!-- MLE On Site -->
                                    <t t-if="row['type'] == 'atelier_employee'">
                                        <tr class="assignment-row">
                                            <t t-if="row.get('show_atelier_header', False)">
                                                <td t-att-rowspan="row['atelier_rowspan']" class="site-cell">
                                                    <div class="site-name">
                                                        <span class="site-fullname">On Site MLE</span>
                                                    </div>
                                                </td>
                                            </t>
                                            <t t-foreach="row['days_assignments']" t-as="day_data">
                                                <td colspan="2" class="assignment-cell full-day-cell">
                                                    <t t-if="day_data['full_day']">
                                                        <div class="assignment-wrapper">
                                                            <div class="assignment-code" t-att-style="day_data['full_day'].get('color_style', '')">
                                                                <t t-esc="day_data['full_day']['code']"/>
                                                            </div>
                                                            <t t-if="day_data['full_day'].get('has_extended_hours', False)">
                                                            <div class="extended-indicator-wrapper">
                                                                <span class="extended-indicator">X</span>
                                                            </div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>

                                    <!-- PERMANENCES -->
                                    <t t-if="row['type'] in ['permanence_functional', 'permanence_technical']">
                                        <tr class="assignment-row">
                                            <td class="site-cell">
                                                <div class="site-name">
                                                    <span class="site-fullname">
                                                        <t t-esc="row['permanence']['name']"/>
                                                    </span>
                                                </div>
                                            </td>
                                            <t t-foreach="row['days_assignments']" t-as="day_data">
                                                <t t-if="day_data['am'] and day_data['am'].get('period') == 'full'">
                                                    <td class="assignment-cell full-day-cell" colspan="2">
                                                        <div class="assignment-wrapper">
                                                            <div class="assignment-code" t-att-style="day_data['am'].get('color_style', '')">
                                                                <t t-esc="day_data['am']['code']"/>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="assignment-cell am-cell">
                                                        <t t-if="day_data['am']">
                                                            <div class="assignment-wrapper">
                                                                <div class="assignment-code" t-att-style="day_data['am'].get('color_style', '')">
                                                                    <t t-esc="day_data['am']['code']"/>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </td>
                                                    <td class="assignment-cell pm-cell">
                                                        <t t-if="day_data['pm']">
                                                            <div class="assignment-wrapper">
                                                                <div class="assignment-code" t-att-style="day_data['pm'].get('color_style', '')">
                                                                    <t t-esc="day_data['pm']['code']"/>
                                                                </div>
                                                                <t t-if="day_data['pm'].get('has_extended_hours', False)">
                                                                    <div class="extended-indicator-wrapper">
                                                                        <span class="extended-indicator">X</span>
                                                                    </div>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </td>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>

                                    <!-- PERMANENCES SPÉCIALES -->
                                    <t t-if="row['type'] == 'special_permanence'">
                                        <tr class="assignment-row">
                                            <td class="site-cell">
                                                <div class="site-name">
                                                    <span class="site-fullname">
                                                        <t t-esc="row['permanence']['name']"/>
                                                    </span>
                                                </div>
                                            </td>
                                            <t t-foreach="row['days_assignments']" t-as="day_data">
                                                <t t-if="day_data.get('full_day')">
                                                    <td class="assignment-cell full-day-cell" colspan="2">
                                                        <div class="assignment-wrapper">
                                                            <div class="assignment-code" t-att-style="day_data['full_day'].get('color_style', '')">
                                                                <t t-esc="day_data['full_day']['code']"/>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td class="assignment-cell am-cell">
                                                        <t t-if="day_data.get('am')">
                                                            <div class="assignment-wrapper">
                                                                <div class="assignment-code" t-att-style="day_data['am'].get('color_style', '')">
                                                                    <t t-esc="day_data['am']['code']"/>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </td>
                                                    <td class="assignment-cell pm-cell">
                                                        <t t-if="day_data.get('pm')">
                                                            <div class="assignment-wrapper">
                                                                <div class="assignment-code" t-att-style="day_data['pm'].get('color_style', '')">
                                                                    <t t-esc="day_data['pm']['code']"/>
                                                                </div>
                                                                <t t-if="day_data['pm'].get('has_extended_hours', False)">
                                                                    <div class="extended-indicator-wrapper">
                                                                        <span class="extended-indicator">X</span>
                                                                    </div>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </td>
                                                </t>
                                            </t>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
    </template>

    <!-- Rapport Odoo -->
    <record id="report_planning_weekly" model="ir.actions.report">
        <field name="name">Planning Hebdomadaire</field>
        <field name="model">chc_cds_planning.planning_weekly</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">chc_cds_planning.report_planning_weekly_pdf</field>
        <field name="print_report_name">'Planning - ' + (object.name or 'Planning')</field>
        <field name="paperformat_id" ref="paperformat_planning_landscape"/>
    </record>
</odoo>

