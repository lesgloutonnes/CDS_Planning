<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sickness_replacement_wizard_form" model="ir.ui.view">
        <field name="name">chc_cds_planning.sickness_replacement_wizard.form</field>
        <field name="model">chc_cds_planning.sickness_replacement_wizard</field>
        <field name="arch" type="xml">
            <form string="Remplacement pour congé maladie">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" readonly="1" nolabel="1"/>
                        </h1>
                        <h2>
                            <field name="leave_period" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <field name="leave_id" invisible="1"/>
                        <field name="employee_id" invisible="1"/>
                        <field name="leave_period" invisible="1"/>
                    </group>
                    
                    <notebook>
                        <page string="Affectations à remplacer"
                              invisible="not replacement_line_ids">
                            <p class="text-muted">
                                Les affectations suivantes ont été trouvées pour la période de congé maladie.
                                Veuillez sélectionner un remplaçant pour chaque affectation si nécessaire.
                            </p>
                            <field name="replacement_line_ids" nolabel="1">
                                <tree editable="bottom" string="Affectations" decoration-info="not replacement_employee_id">
                                    <field name="planning_name" string="Planning" readonly="1"/>
                                    <field name="assignment_date" string="Date" readonly="1"/>
                                    <field name="day_label" string="Jour" readonly="1"/>
                                    <field name="period_label" string="Période" readonly="1"/>
                                    <field name="site_name" string="Site" readonly="1"/>
                                    <field name="permanence_type_name" string="Type de permanence" readonly="1"/>
                                    <field name="special_name" string="Permanence spéciale" readonly="1"/>
                                    <field name="replacement_employee_id" string="Remplaçant" 
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           required="0"/>
                                    <field name="assignment_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Congés annuels en conflit"
                              invisible="not annual_leave_conflict_line_ids">
                            <div class="alert alert-warning mb-3" role="alert">
                                <strong>Congés qui chevauchent la période de maladie.</strong>
                                Choisissez l'action à effectuer pour chacun d'eux.
                                Les jours annulés sont restitués au solde de l'employé.
                            </div>
                            <field name="annual_leave_conflict_line_ids" nolabel="1">
                                <tree editable="bottom"
                                      string="Congés annuels en conflit"
                                      decoration-danger="action == 'cancel'"
                                      decoration-warning="action == 'split'"
                                      decoration-muted="action == 'keep'"
                                      create="0"
                                      delete="0">
                                    <field name="leave_type_name" string="Type de congé" readonly="1"/>
                                    <field name="leave_period" string="Période du congé" readonly="1"/>
                                    <field name="overlap_period" string="Jours en conflit" readonly="1"/>
                                    <field name="action" string="Action"
                                           widget="selection"
                                           options="{'no_open': True}"/>
                                    <field name="leave_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <div class="alert alert-info mt-2" role="alert">
                                <ul class="mb-0">
                                    <li><strong>Conserver tel quel</strong> : aucune modification du congé.</li>
                                    <li><strong>Annuler</strong> : le congé passe en état "Refusé" ; le solde est restitué et l'employé peut redéposer une demande pour les jours non malades.</li>
                                    <li><strong>Annuler et recréer les jours restants</strong> : annule le congé original et recrée automatiquement, validés, les jours en dehors de la période de maladie (visible seulement en cas de chevauchement partiel).</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_apply_replacements" type="object"
                        string="Appliquer les remplacements" class="btn-primary"/>
                    <button string="Ignorer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
