<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour le générateur mensuel -->
    <record id="view_monthly_planning_generator_form" model="ir.ui.view">
        <field name="name">chc_cds_planning.monthly_planning_generator.form</field>
        <field name="model">chc_cds_planning.monthly_planning_generator</field>
        <field name="arch" type="xml">
            <form string="Générateur de Planning Mensuel">
                <sheet>
                    <!-- Période & Options -->
                    <group>
                        <group string="Période">
                            <field name="month" required="1" placeholder="Sélectionner le mois..." />
                            <field name="year" required="1" placeholder="Année (ex : 2025)" widget="char" />
                        </group>

                        <group string="Options">
                            <field name="replace_existing"
                                   help="Si activé, les plannings existants du mois seront remplacés." />
                        </group>
                    </group>

                    <!-- Informations -->
                        <div>
                            <h4>
                                <i class="fa fa-info-circle me-1"></i>
                                Principes appliqués
                            </h4>
                            <ul>
                                <li><b>Qualifications respectées :</b> attribution selon compétences/priorités</li>
                                <li><b>Équilibrage :</b> charges réparties sur tout le mois</li>
                                <li><b>Rotation intelligente :</b> évite la surcharge, intègre tous les qualifiés</li>
                                <li><b>Gestion des congés :</b> contrôle des absences avant affectation</li>
                            </ul>
                        </div>
                </sheet>

                <!-- Boutons -->
                <footer>
                    <button name="action_generate_monthly_planning"
                            string="Générer"
                            type="object"
                            class="btn-primary"
                            confirm="Voulez-vous générer tous les plannings pour ce mois ?" />
                    <button string="Annuler"
                            class="btn-secondary"
                            special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le générateur -->
    <record id="action_monthly_planning_generator" model="ir.actions.act_window">
        <field name="name">Générateur de Planning Mensuel</field>
        <field name="res_model">chc_cds_planning.monthly_planning_generator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
