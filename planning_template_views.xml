<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vues pour les sites -->
    <record id="view_chc_cds_planning_site_form" model="ir.ui.view">
        <field name="name">chc_cds_planning.site.form</field>
        <field name="model">chc_cds_planning.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="address" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="color" widget="color_picker" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chc_cds_planning_site_tree" model="ir.ui.view">
        <field name="name">chc_cds_planning.site.tree</field>
        <field name="model">chc_cds_planning.site</field>
        <field name="arch" type="xml">
            <tree string="Sites">
                <field name="code" />
                <field name="name" />
                <field name="address" />
            </tree>
        </field>
    </record>

    <record id="action_chc_cds_planning_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">chc_cds_planning.site</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>