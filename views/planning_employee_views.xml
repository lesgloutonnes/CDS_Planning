<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les employés (ajout des qualifications et préférences) -->
    <record id="view_employee_form_inherit_planning" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.planning</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Planning CDS" name="chc_cds_planning">
                    <group>
                        <group>
                            <field name="min_days_per_week" />
                            <field name="employee_code" placeholder="Ex: ROMAC, PIMAC, CHBUS" />
                        </group>
                        <group>
                            <field name="max_days_per_week" />
                            <field name="color" help="0=Jaune, 1=Rouge, 2=Vert, 3=Bleu, etc." />
                            <field name="skin_enabled" />
                            <field name="skin_type" invisible="not skin_enabled" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Qualifications">
                            <field name="qualification_ids">
                                <tree editable="bottom">
                                    <field name="permanence_type_id" />
                                    <field name="site_id" />
                                    <field name="priority" />
                                </tree>
                            </field>
                        </page>
                       <page string="Indisponibilités">
                            <field name="unavailability_ids" create="1" edit="1">
                                <tree string="Indisponibilités">
                                    <field name="employee_id" invisible="1" column_invisible="1" />
                                    <field name="day_of_week" />
                                    <field name="am" widget="boolean_toggle" />
                                    <field name="pm" widget="boolean_toggle" />
                                    <field name="reason" />
                                </tree>

                                <form string="Indisponibilité">
                                    <group>
                                        <group>
                                            <field name="day_of_week" />
                                            <field name="reason" />
                                        </group>

                                        <group>
                                            <field name="am" />
                                            <field name="pm" />
                                        </group>
                                        
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Affectations">
                            <field name="assignment_ids" readonly="1">
                                <tree editable="bottom">
                                    <field name="planning_week_id" />
                                    <field name="site_id" />
                                    <field name="permanence_type_id"
                                        domain="[('site_ids', 'in', site_id)]" />
                                    <field name="day" />
                                    <field name="period" />
                                    <field name="notes" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Vue liste sans widget -->
    <record id="view_employee_tree_inherit_planning" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.planning</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="employee_code" />
                <field name="color" />
            </field>
        </field>
    </record>

    <record id="action_chc_cds_planning_employee_hr" model="ir.actions.act_window">
        <field name="name">Employés</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>