<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chc_cds_planning_l1_guard_calendar_form" model="ir.ui.view">
        <field name="name">chc_cds_planning.l1_guard_calendar.form</field>
        <field name="model">chc_cds_planning.l1_guard_calendar</field>
        <field name="arch" type="xml">
            <form string="Calendrier de garde L1">
                <sheet>
                    <group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="l1_code" />
                        </group>
                        <group>
                            <field name="employee_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_chc_cds_planning_l1_guard_calendar_tree" model="ir.ui.view">
        <field name="name">chc_cds_planning.l1_guard_calendar.tree</field>
        <field name="model">chc_cds_planning.l1_guard_calendar</field>
        <field name="arch" type="xml">
            <tree string="Semaine de garde">
                <field name="date_start" />
                <field name="date_end" />
                <field name="l1_code" />
                <field name="employee_id" />
            </tree>
        </field>
    </record>

    <record id="action_chc_cds_planning_l1_guard_calendar" model="ir.actions.act_window">
        <field name="name">Calendrier de garde L1</field>
        <field name="res_model">chc_cds_planning.l1_guard_calendar</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
