<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_chc_cds_planning_presence_stats_tree" model="ir.ui.view">
        <field name="name">chc_cds_planning.presence_stats.tree</field>
        <field name="model">chc_cds_planning.planning_presence_stats</field>
        <field name="arch" type="xml">
            <tree string="Statistiques de présence" create="false" edit="false" delete="false"
                decoration-danger="deviation_from_avg &gt; 1"
                decoration-warning="deviation_from_avg &gt; 0 and deviation_from_avg &lt;= 1"
                decoration-success="deviation_from_avg &lt; 0">
                <header>
                    <button name="action_refresh_stats" type="object"
                        string="Actualiser" class="btn-primary"
                        display="always"/>
                </header>
                <field name="employee_code" />
                <field name="employee_name" />
                <field name="is_rotation_eligible" optional="show" />
                <field name="total_presence" sum="Total" optional="show" />
                <field name="friday_pm_fct" string="Perm FCT" sum="Total Perm FCT" />
                <field name="friday_pm_tch" string="Perm TCH" sum="Total Perm TCH" />
                <field name="friday_pm_total" string="Compteur Vendredi PM" sum="Total Vendredi PM" />
                <field name="rotation_counter_fct" string="Compteur FCT" sum="Rotation FCT" optional="show" />
                <field name="rotation_counter_tch" string="Compteur TCH" sum="Rotation TCH" optional="show" />
                <field name="rotation_counter" string="Compteur total" sum="Rotation total" optional="hide" />
                <field name="deviation_from_avg" string="Écart vs moyenne" optional="show" />
                <field name="last_friday_pm_date" optional="hide" />
                <field name="stats_year" optional="show" />
            </tree>
        </field>
    </record>

    <record id="view_chc_cds_planning_presence_stats_search" model="ir.ui.view">
        <field name="name">chc_cds_planning.presence_stats.search</field>
        <field name="model">chc_cds_planning.planning_presence_stats</field>
        <field name="arch" type="xml">
            <search string="Rechercher stats">
                <field name="employee_name" />
                <field name="employee_code" />
                <field name="stats_year" />
                <filter name="rotation_eligible" string="Éligibles rotation"
                    domain="[('is_rotation_eligible', '=', True)]" />
                <filter name="has_friday_pm" string="Avec compteur vendredi PM"
                    domain="[('friday_pm_total', '&gt;', 0)]" />
                <filter name="overloaded" string="Au-dessus de la moyenne"
                    domain="[('deviation_from_avg', '&gt;', 0)]" />
                <filter name="underloaded" string="En-dessous de la moyenne"
                    domain="[('deviation_from_avg', '&lt;', 0)]" />
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_eligible" string="Éligibilité rotation"
                        context="{'group_by': 'is_rotation_eligible'}" />
                    <filter name="group_year" string="Année"
                        context="{'group_by': 'stats_year'}" />
                </group>            </search>
        </field>
    </record>

    <record id="view_chc_cds_planning_presence_stats_pivot" model="ir.ui.view">
        <field name="name">chc_cds_planning.presence_stats.pivot</field>
        <field name="model">chc_cds_planning.planning_presence_stats</field>
        <field name="arch" type="xml">
            <pivot string="Analyse permanences &amp; vendredis PM">
                <field name="employee_name" type="row" />
                <field name="friday_pm_fct" type="measure" />
                <field name="friday_pm_tch" type="measure" />
                <field name="friday_pm_total" type="measure" />
                <field name="total_presence" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="view_chc_cds_planning_presence_stats_graph" model="ir.ui.view">
        <field name="name">chc_cds_planning.presence_stats.graph</field>
        <field name="model">chc_cds_planning.planning_presence_stats</field>
        <field name="arch" type="xml">
            <graph string="Perm FCT / Perm TCH" type="bar" stacked="True">
                <field name="employee_name" />
                <field name="friday_pm_fct" type="measure" />
                <field name="friday_pm_tch" type="measure" />
            </graph>
        </field>
    </record>

    <record id="action_chc_cds_planning_presence_stats" model="ir.actions.act_window">
        <field name="name">Stats présence &amp; vendredis PM</field>
        <field name="res_model">chc_cds_planning.planning_presence_stats</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_chc_cds_planning_presence_stats_search" />
        <field name="context">{'search_default_rotation_eligible': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune statistique disponible
            </p>
            <p>
                Cliquez sur « Actualiser » pour calculer les statistiques de présence :
                Perm FCT, Perm TCH (hors on site) et Compteur Vendredi PM.
                Les lignes en rouge/orange indiquent une charge au-dessus de la moyenne.
            </p>
        </field>
    </record>

    <record id="action_refresh_presence_stats" model="ir.actions.server">
        <field name="name">Actualiser les stats</field>
        <field name="model_id" ref="model_chc_cds_planning_planning_presence_stats" />
        <field name="binding_model_id" ref="model_chc_cds_planning_planning_presence_stats" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('chc_cds_planning.group_planning_admin'))]" />
        <field name="state">code</field>
        <field name="code">action = model.action_refresh_stats()</field>
    </record>

</odoo>
