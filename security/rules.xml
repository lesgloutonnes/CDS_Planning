<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planning_weekly_rule_user_hide_draft" model="ir.rule">
        <field name="name">Planning Weekly - Users hide draft</field>
        <field name="model_id" ref="model_chc_cds_planning_planning_weekly" />
        <field name="domain_force">
            [('state', '!=', 'draft')]
        </field>
        <field name="groups" eval="[(4, ref('chc_cds_planning.group_planning_user'))]" />
    </record>

    <record id="planning_weekly_rule_admin_full" model="ir.rule">
        <field name="name">Planning Weekly - Admin full access</field>
        <field name="model_id" ref="model_chc_cds_planning_planning_weekly" />
        <field name="domain_force">[(1,'=',1)]</field> <!-- Tout voir -->
        <field name="groups" eval="[(4, ref('chc_cds_planning.group_planning_admin'))]" />
    </record>

</odoo>